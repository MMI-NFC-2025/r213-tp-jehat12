---
const { offre } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow">
  <img src={offre.image} alt={offre.nomMaison} class="w-full h-48 object-cover" />
  
  <div class="p-4">
    <div class="flex justify-between items-start mb-2">
      <h3 class="text-xl font-bold text-slate-900">{offre.nomMaison}</h3>
      {offre.favori && (
        <span class="bg-yellow-400 text-yellow-900 text-xs font-semibold px-2 py-1 rounded">
          Favori
        </span>
      )}
    </div>
    
    <p class="text-slate-600 text-sm mb-3">{offre.adresse}</p>
    
    <div class="space-y-2">
      <p class="text-2xl font-bold text-slate-900">{offre.prix} €</p>
      
      <div class="flex gap-4 text-sm text-slate-600">
        <span>{offre.surface} m²</span>
        <span>{offre.nbChambres} chambres</span>
        <span>{offre.nbSdb} sdb</span>
      </div>
    </div>
  </div>
</div>
