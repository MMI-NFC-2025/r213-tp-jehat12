---
import PbImages from "./PbImages.astro";
const { offre } = Astro.props;
---

<article class="overflow-hidden rounded-lg bg-white shadow">
  <PbImages
    record={offre}
    recordImage={offre.images?.[0]}
    width={800}
    height={520}
  />
  <div class="p-4">
    <h3 class="text-lg font-semibold text-slate-900">
      {offre.titre || offre.nomMaison}
    </h3>
    <a
      href={`/offres/${offre.id}`}
      class="mt-4 inline-block rounded-xl bg-slate-700 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-800"
    >
      Voir l'offre
    </a>
  </div>
</article>
