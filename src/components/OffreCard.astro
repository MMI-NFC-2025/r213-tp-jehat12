---
import PbImages from "./PbImages.astro";
const { offre } = Astro.props;
---

<article class="overflow-hidden rounded-lg bg-white shadow">
  <PbImages
    record={offre}
    recordImage={offre.images?.[0]}
    width={800}
    height={520}
  />
  <h3 class="p-4 text-lg font-semibold text-slate-900">
    {offre.nomMaison}
  </h3>
</article>
