---
import { Image } from "astro:assets";
import { getImageUrl } from "../backend.mjs";

const {
  record,
  recordImage,
  width = 400,
  height = 300,
} = Astro.props;

const imageURL = record && recordImage ? getImageUrl(record, recordImage) : null;
---

{imageURL && (
  <Image
    src={imageURL}
    alt={record.nomMaison || "Image"}
    width={width}
    height={height}
    inferSize={true}
  />
)}
