---
const { offre } = Astro.props;
---

<article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">
        {offre.type} • {offre.ville}
      </p>
      <h2 class="mt-1 text-lg font-semibold text-slate-900">{offre.titre}</h2>
    </div>

    <p class="text-lg font-extrabold text-slate-900">
      {offre.prix}€<span class="text-sm font-semibold text-slate-500">/mois</span>
    </p>
  </div>

  <ul class="mt-4 flex gap-3 text-sm text-slate-600">
    <li class="rounded-xl bg-slate-100 px-3 py-2">{offre.surface} m²</li>
    <li class="rounded-xl bg-slate-100 px-3 py-2">{offre.pieces} pièce(s)</li>
  </ul>

  <a
    href="#"
    class="mt-4 inline-flex w-full items-center justify-center rounded-xl bg-slate-900 px-4 py-3 text-sm font-semibold text-white hover:bg-slate-800"
  >
    Voir l’offre
  </a>
</article>
