---
import Layout from '../../layouts/Layout.astro';
import { addOffre } from '../../backend.mjs';

let message = '';
if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const response = await addOffre(formData);
  message = response.message;
}
---

<Layout titre="Ajouter offre">
  <section class="mx-auto max-w-xl px-6 py-10">
    <div class="flex items-end justify-between mb-8">
      <h1 class="text-3xl font-extrabold text-slate-900">Ajouter offre</h1>
      <a href="/offres" class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200">Offres</a>
    </div>
    
    {message && (
      <div class="mb-6 p-4 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-900 text-sm">
        {message}
      </div>
    )}
    
    <form action="/offres/add" method="POST" enctype="multipart/form-data" class="space-y-4 bg-white p-8 rounded-2xl shadow-lg">
      <input type="text" name="nomMaison" placeholder="Nom de la maison" required class="w-full p-4 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
      <input type="number" name="prix" placeholder="Prix (€)" class="w-full p-4 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
      <input type="number" name="nbSdb" placeholder="Nb salles de bain" class="w-full p-4 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
      <input type="number" name="nbChambres" placeholder="Nb chambres" class="w-full p-4 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
      <input type="number" name="surface" placeholder="Surface (m²)" class="w-full p-4 border border-slate-300 rounded-xl focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" />
      <input type="file" name="images" class="w-full p-4 border border-slate-300 rounded-xl file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-slate-900 file:text-sm file:font-semibold file:text-white hover:file:bg-slate-800" />
      <button type="submit" class="w-full rounded-xl bg-slate-900 py-4 text-lg font-semibold text-white hover:bg-slate-800 transition-all">Ajouter l'offre</button>
    </form>
  </section>
</Layout>
