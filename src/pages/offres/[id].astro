---
import Layout from "../../layouts/Layout.astro";
import PbImages from "../../components/PbImages.astro";
import { getOffre } from "../../backend.mjs";

const { id } = Astro.params;

if (!id) {
  return Astro.redirect("/offres");
}

const offre = await getOffre(id);

if (!offre) {
  return Astro.redirect("/offres");
}
---

<Layout titre={offre.titre}>
  <section class="mx-auto max-w-4xl px-6 py-10">
    <div class="mb-6">
      <a
        href="/offres"
        class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200"
      >
        ← Retour aux offres
      </a>
    </div>

    <article class="overflow-hidden rounded-xl bg-white shadow-lg">
      {offre.images && offre.images.length > 0 && (
        <PbImages
          record={offre}
          recordImage="images"
          width={1200}
          height={600}
        />
      )}

      <div class="p-8">
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">
          {offre.titre}
        </h1>

        <div class="mt-6 grid grid-cols-1 gap-6 md:grid-cols-2">
          <div class="rounded-lg bg-slate-50 p-4">
            <p class="text-sm font-semibold text-slate-600">Ville</p>
            <p class="mt-1 text-lg text-slate-900">{offre.ville}</p>
          </div>

          <div class="rounded-lg bg-slate-50 p-4">
            <p class="text-sm font-semibold text-slate-600">Type</p>
            <p class="mt-1 text-lg text-slate-900">{offre.type}</p>
          </div>

          <div class="rounded-lg bg-slate-50 p-4">
            <p class="text-sm font-semibold text-slate-600">Prix</p>
            <p class="mt-1 text-lg font-bold text-slate-900">
              {offre.prix.toLocaleString()} €
            </p>
          </div>

          <div class="rounded-lg bg-slate-50 p-4">
            <p class="text-sm font-semibold text-slate-600">Surface</p>
            <p class="mt-1 text-lg text-slate-900">{offre.surface} m²</p>
          </div>

          <div class="rounded-lg bg-slate-50 p-4">
            <p class="text-sm font-semibold text-slate-600">Pièces</p>
            <p class="mt-1 text-lg text-slate-900">{offre.pieces}</p>
          </div>

          {offre.favori && (
            <div class="rounded-lg bg-yellow-50 p-4">
              <p class="text-sm font-semibold text-yellow-700">⭐ Favori</p>
            </div>
          )}
        </div>
      </div>
    </article>
  </section>
</Layout>
