---
import Layout from "../../layouts/Layout.astro";
import { getAgents } from "../../backend.mjs";

const agents = await getAgents();
---

<Layout titre="Agents">
  <section class="mx-auto max-w-7xl px-6 py-10">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Agents</h1>
        <p class="mt-2 text-slate-600">Notre équipe d'agents immobiliers.</p>
      </div>
      <a href="/" class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200">
        Retour accueil
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {agents.map((agent) => (
        <div class="rounded-2xl bg-white shadow p-6 flex flex-col gap-3">
          <h2 class="text-xl font-bold text-slate-900">{agent.prenom} {agent.nom}</h2>
          <p class="text-slate-500 text-sm">{agent.email}</p>
          <a
            href={`/agents/${agent.id}`}
            class="mt-auto inline-block rounded-xl bg-slate-800 px-4 py-2 text-sm font-semibold text-white hover:bg-slate-900 text-center"
          >
            Voir ses offres
          </a>
        </div>
      ))}
    </div>
  </section>
</Layout>
