---
import Layout from "../layouts/Layout.astro";
import OfferCard from "../components/OfferCard.astro";
import { offres } from "../data/offres.js";
---

<Layout titre="Offres">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <div class="flex items-end justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Offres</h1>
        <p class="mt-2 text-slate-600">Découvrez nos biens disponibles.</p>
      </div>

      <a
        href="/"
        class="rounded-xl px-3 py-2 text-sm font-semibold text-slate-700 hover:bg-slate-200"
      >
        Retour accueil
      </a>
    </div>

    <div class="mt-8 grid gap-4">
      {offres.map((offre) => <OfferCard offre={offre} />)}
    </div>
  </section>
</Layout>
