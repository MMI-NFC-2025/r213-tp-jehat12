---
import Layout from "../layouts/Layout.astro";
---

<Layout titre="Offres">
  <section class="mx-auto max-w-4xl px-6 py-10">
    <h1 class="text-3xl font-extrabold tracking-tight text-slate-900">Offres</h1>

    <ul class="mt-6 grid gap-4">
      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm text-slate-500">Appartement • T2 • Centre-ville</p>
        <p class="mt-1 text-lg font-semibold text-slate-900">650€ / mois</p>
      </li>

      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm text-slate-500">Maison • T4 • Jardin</p>
        <p class="mt-1 text-lg font-semibold text-slate-900">1 250€ / mois</p>
      </li>

      <li class="rounded-2xl border border-slate-200 bg-white p-5">
        <p class="text-sm text-slate-500">Studio • Proche transports</p>
        <p class="mt-1 text-lg font-semibold text-slate-900">480€ / mois</p>
      </li>
    </ul>
  </section>
</Layout>
