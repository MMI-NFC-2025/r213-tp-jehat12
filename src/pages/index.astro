---
import Layout from "../layouts/Layout.astro";
---

<Layout titre="Accueil">
  <section class="mx-auto max-w-4xl px-6 py-12">
    <h1 class="text-4xl font-extrabold tracking-tight text-slate-900">
      Votre agence immobilière, simplement.
    </h1>

    <p class="mt-4 max-w-prose text-slate-600">
      Location et vente de biens. Trouvez rapidement un appartement ou une maison qui vous correspond.
    </p>

    <div class="mt-6 flex gap-3">
      <a
        href="/offres"
        class="rounded-2xl bg-slate-900 px-5 py-3 text-sm font-semibold text-white hover:bg-slate-800"
      >
        Voir les offres
      </a>
      <a
        href="#"
        class="rounded-2xl bg-white px-5 py-3 text-sm font-semibold text-slate-900 ring-1 ring-slate-200 hover:bg-slate-50"
      >
        Nous contacter
      </a>
    </div>
  </section>
</Layout>
